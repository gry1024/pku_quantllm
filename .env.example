# =============================================================================
# SIMNOW 凭证（请勿提交 .env）
# 复制本文件为 .env 并填入；本文件不持有任何默认值
# 仓内 ctp_demo.py / ctp_breakout_demo.py 都从仓库根的 .env 读取
# =============================================================================

# --- SIMNOW 实盘时段前置（仅交易日交易时段可用）---
# CTP_TD_ADDRESS=tcp://182.254.243.31:30001
# CTP_MD_ADDRESS=tcp://182.254.243.31:30011

# --- SIMNOW 7×24 仿真前置（全天候可连，价格为模拟价）---
# 注意：传统 7×24 端点 180.168.146.131:10202/:10212 的 CTP 协议已停服，
#       TCP 可达但握手后会立即断开（reason 4097）。
#       实测可用：182.254.243.31:40001/:40011。
CTP_TD_ADDRESS=tcp://182.254.243.31:40001
CTP_MD_ADDRESS=tcp://182.254.243.31:40011

# --- 账号信息 ---
CTP_USERID=
CTP_PASSWORD=
CTP_BROKERID=9999

# --- 终端认证（SIMNOW 默认）---
CTP_APPID=simnow_client_test
CTP_AUTH_CODE=0000000000000000

# --- 柜台环境：实盘 / 测试 ---
CTP_ENV=实盘