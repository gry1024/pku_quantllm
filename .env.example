# =============================================================================
# SIMNOW 凭证（请勿提交 .env）
# 复制本文件为 .env 并填入；本文件不持有任何默认值
# 所有脚本（ctp_demo.py / ctp_breakout_demo.py / intraday_alpha/live/ctp_runner.py）
# 都从仓库根的 .env 读取
# =============================================================================

# --- SIMNOW 实盘时段前置（仅交易日交易时段可用）---
CTP_TD_ADDRESS=tcp://182.254.243.31:30001
CTP_MD_ADDRESS=tcp://182.254.243.31:30011

# --- SIMNOW 7×24 仿真前置（全天候可连，价格为模拟价）---
# CTP_TD_ADDRESS=tcp://180.168.146.131:10202
# CTP_MD_ADDRESS=tcp://180.168.146.131:10212

# --- 账号信息 ---
CTP_USERID=
CTP_PASSWORD=
CTP_BROKERID=9999

# --- 终端认证（SIMNOW 默认）---
CTP_APPID=simnow_client_test
CTP_AUTH_CODE=0000000000000000

# --- 柜台环境：实盘 / 测试 ---
CTP_ENV=实盘

# --- 以下仅 intraday_alpha/live/ctp_runner.py 使用 ---
# 标的（订阅必须顺一整月；摘牌合约订阅不报错但收不到行情）
INTRADAY_VT_SYMBOL=au2612.SHFE

# 信号文件路径（必须与 intraday_alpha/research/intraday_alpha/config.json 的 signal_path 一致）
INTRADAY_SIGNAL_PATH=./lab/intraday/signal/intraday_live_signal.json

# 策略参数（一般不用改）
INTRADAY_FIXED_SIZE=1
INTRADAY_THRESHOLD_LONG=0.0008
INTRADAY_THRESHOLD_SHORT=0.0008
INTRADAY_PRICE_ADD_TICKS=2
INTRADAY_STALE_HOURS=24